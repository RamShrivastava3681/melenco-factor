# Whizunik Factoring Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=6767

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8080

# Frontend base URL used in NOA email links
NOA_FRONTEND_URL=https://factor.whizunikhub.com

# JWT Configuration
JWT_SECRET=whizunik-factoring-secret-key-change-in-production

# Admin Credentials
ADMIN_EMAIL=admin@whizunik.com
ADMIN_PASSWORD=your_admin_password_here

# Database Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE=whizunik-factoring

# Logging
LOG_LEVEL=info